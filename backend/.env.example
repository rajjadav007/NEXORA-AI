# Application Configuration
APP_NAME="nexora-ai-api"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/nexora_ai"
TEST_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/nexora_ai_test"

# CORS Configuration
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:3000"

# AI / Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:12b"
OLLAMA_TIMEOUT_SECONDS=60.0

# Storage
RESUME_UPLOAD_MAX_SIZE_BYTES=10485760
RESUME_UPLOAD_STAGING_DIR="storage/staging/resumes"
RESUME_STORAGE_DIR="storage/resumes"
